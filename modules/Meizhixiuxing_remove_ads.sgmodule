#!name=美丽修行去广告（Egern转换版）
#!desc=移除开屏广告、首页广告、发现页广告、美修盒页面广告、下拉广告、弹窗广告、搜索推广、版本更新弹窗及我的页面广告。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://api\.bevol\.com/appmain/app/home/launch$ reject-dict
^https://api\.bevol\.com/appmain/app/home/popup$ reject-dict
^https://api\.bevol\.com/personal/page$ reject-dict
^https://api\.bevol\.com/seach/foundAndTopSearch$ reject-dict

[Script]
Meizhixiuxing_remove_ads-op0 = type=http-response, pattern=^https://api\.bevol\.com/appmain/app/home/page$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Meizhixiuxing_remove_ads.js, requires-body=1, argument=0
Meizhixiuxing_remove_ads-op1 = type=http-response, pattern=^https://api\.bevol\.com/appmain/app/home/feed$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Meizhixiuxing_remove_ads.js, requires-body=1, argument=1
Meizhixiuxing_remove_ads-op2 = type=http-response, pattern=^https://api\.bevol\.com/appmain/app/home/feed$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Meizhixiuxing_remove_ads.js, requires-body=1, argument=2
Meizhixiuxing_remove_ads-op3 = type=http-response, pattern=^https://api\.bevol\.com/trialbox/shop/app/homePage$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Meizhixiuxing_remove_ads.js, requires-body=1, argument=3

[MITM]
hostname = %APPEND% api.bevol.com
