#!desc=移除开屏广告、横幅广告，精简我的页面。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://fanyi-app\.baidu\.com/transapp/v2/api/launch/config\? reject-dict
^https://fanyi-app\.baidu\.com/static/react-activity/page/courseBoutique\.html\? reject

[Script]
BaiduTranslate_remove_ads-op0 = type=http-response, pattern=^https://fanyi-app\.baidu\.com/transapp/comment/my\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/BaiduTranslate_remove_ads.js, requires-body=1, argument=0
BaiduTranslate_remove_ads-op1 = type=http-response, pattern=^https://fanyi-app\.baidu\.com/transapp/recitewd/myplan\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/BaiduTranslate_remove_ads.js, requires-body=1, argument=1

[MITM]
hostname = %APPEND% fanyi-app.baidu.com
