#!name=Tumblr去广告（Egern转换版）
#!desc=移除信息流广告｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Script]
Tumblr_remove_ads-op0 = type=http-response, pattern=^https://api-http2\.tumblr\.com/v2/config$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Tumblr_remove_ads.js, requires-body=1, argument=0

[MITM]
hostname = %APPEND% api-http2.tumblr.com
