#!name=YY去广告（Egern转换版）
#!desc=移除开屏广告、应用内弹窗，精简底栏和我的页面。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
DOMAIN, splash.yy.com, REJECT
DOMAIN, dsp-ad.yy.com, REJECT
DOMAIN, ysad.yy.com, REJECT

[URL Rewrite]
^https://yyapp-fastnet\.yy\.com/dispatch\? reject-dict
^https://data\.3g\.yy\.com/popup/topLiveCardPopup\? reject-dict
^https://yyapp-act-entrance\.yy\.com/entrance/list\? reject-dict

[Script]
YY_Voice_remove_ads-op0 = type=http-response, pattern=^https://yyapp-idx\.yy\.com/mobyy/nav/index/idx\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/YY_Voice_remove_ads.js, requires-body=1, argument=0
YY_Voice_remove_ads-op1 = type=http-response, pattern=^https://tab\.yy\.com/tabs\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/YY_Voice_remove_ads.js, requires-body=1, argument=1
YY_Voice_remove_ads-op2 = type=http-response, pattern=^https://tab\.yy\.com/tabs\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/YY_Voice_remove_ads.js, requires-body=1, argument=2
YY_Voice_remove_ads-op3 = type=http-response, pattern=^https://personal-center\.yy\.com/personalCenter/list\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/YY_Voice_remove_ads.js, requires-body=1, argument=3

[MITM]
hostname = %APPEND% yyapp-act-entrance.yy.com, yyapp-fastnet.yy.com, personal-center.yy.com, tab.yy.com, data.3g.yy.com, yyapp-idx.yy.com
