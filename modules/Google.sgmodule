#!name=Google搜索重定向（Egern转换版）
#!desc=将Google搜索重定向至.com域名，如遇频繁跳转请禁用本插件。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https?://(www.)?(g|google)\.cn https://www.google.com 307
^https?://(ditu|maps).google\.cn https://maps.google.com 307

[MITM]
hostname = %APPEND% www.google.cn
