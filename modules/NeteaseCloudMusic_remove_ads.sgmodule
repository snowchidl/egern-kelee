#!name=网易云音乐去广告（Egern转换版）
#!desc=过滤网易云音乐广告，并允许自定义界面。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
DOMAIN, iadmat.nosdn.127.net, REJECT
DOMAIN, iadmatapk.nosdn.127.net, REJECT
DOMAIN, iadmusicmat.music.126.net, REJECT
DOMAIN, iadmusicmatvideo.music.126.net, REJECT
DOMAIN, ipv4.music.163.com, REJECT
DOMAIN, ipv6.music.163.com, REJECT

[URL Rewrite]
^https?://interface\d?\.music\.163\.com/eapi/(?:delivery/(batch-)?deliver|moment/tab/info/|side-bar/mini-program/music-service/account|yunbei/account/entrance/) reject-dict
^https?://interface\d?\.music\.163\.com/eapi/(?:community/friends/fans-group/artist/group/|mine/applet/redpoint|music/songshare/text/recommend/|resniche/position/play/new/|resniche/tspopup/show|resource/comments?/musiciansaid/|user/sub/artist) reject-dict
^https?://interface\d?\.music\.163\.com/eapi/(?:ios/version|mlivestream/entrance/playpage/|link/position/show/strategy|link/scene/show/resource|v1/content/exposure/comment/banner/) reject-dict
^https?://interface\d?\.music\.163\.com/w?eapi/(?:activity/bonus/playpage/time/query|resource-exposure/|search/(?:chart/|rcmd/keyword/|specialkeyword/)) reject-dict
^https://interface\d\.music\.163\.com/eapi/my/podcast/tab/recommend reject-dict

[Script]
NeteaseCloudMusic_remove_ads-op0 = type=http-response, pattern=^https?://interface\d?\.music\.163\.com/e?api/(ocpc/)?ad/, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/NeteaseCloudMusic_remove_ads.js, argument=0
NeteaseCloudMusic_remove_ads-op1 = type=http-response, pattern=^https?://interface\d?\.music\.163.com/w?e?api/search/default, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/NeteaseCloudMusic_remove_ads.js, argument=1
评论区、热推、有话想说、分享一下、歌曲下的祝福等小提示 = type=http-response, pattern=^https?://interface\d?\.music\.163\.com/eapi/(?:batch|v2/resource/comment/floor/get), script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js, requires-body=1, binary-body-mode=1
推荐、home、主页 = type=http-response, pattern=^https?://interface\d?\.music\.163\.com/eapi/(?:homepage/block/page|link/page/rcmd/(?:block/resource/multi/refresh|resource/show)), script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js, requires-body=1, binary-body-mode=1
底部选项卡 = type=http-response, pattern=^https?://interface\d?\.music\.163\.com/eapi/link/home/framework/tab, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js, requires-body=1, binary-body-mode=1
发现页 = type=http-response, pattern=^https?://interface\d?\.music\.163\.com/eapi/link/page/discovery/resource/show, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js, requires-body=1, binary-body-mode=1
我的页面 = type=http-response, pattern=^https?://interface\d?\.music\.163\.com/eapi/link/position/show/resource, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js, requires-body=1, binary-body-mode=1
显示未关注你的人 = type=http-response, pattern=^https?://interface\d?\.music\.163\.com/eapi/user/follow/users/mixed/get, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js, requires-body=1, binary-body-mode=1

[MITM]
hostname = %APPEND% interface*.music.163.com
