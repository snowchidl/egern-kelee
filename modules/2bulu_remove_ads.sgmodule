#!name=两步路户外助手去广告（Egern转换版）
#!desc=移除开屏广告、弹窗广告，精简我的页面。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://helper\.2bulu\.com/search/searchHotKeyList\? reject-dict
^https://helper\.2bulu\.com/promote/getAppUserModule\? reject-dict
^https://helper\.2bulu\.com/proSpecial/allData\? reject-dict

[Script]
2bulu_remove_ads-op0 = type=http-response, pattern=^https://helper\.2bulu\.com/getAppEntranceConfig\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/2bulu_remove_ads.js, requires-body=1, argument=0

[MITM]
hostname = %APPEND% helper.2bulu.com
