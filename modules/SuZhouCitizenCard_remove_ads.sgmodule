#!name=智慧苏州去广告（Egern转换版）
#!desc=移除开屏广告、横幅，移除信息流推广。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Script]
SuZhouCitizenCard_remove_ads-op0 = type=http-response, pattern=^https?://newapp2\.szsmk\.com/app/config/queryMainAd, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/SuZhouCitizenCard_remove_ads.js, argument=0
SuZhouCitizenCard_remove_ads-op1 = type=http-response, pattern=^https?://newapp2\.szsmk\.com/app/config/(queryCarousel|queryRecommendation)/, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/SuZhouCitizenCard_remove_ads.js, argument=1

[MITM]
hostname = %APPEND% newapp2.szsmk.com
