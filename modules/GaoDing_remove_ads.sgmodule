#!name=稿定设计去广告（Egern转换版）
#!desc=移除稿定设计开屏广告、首页轮播图和弹窗，移除功能入口角标。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://www\.gaoding\.com/api/v\d/oc/v\d/delivery-pits/ios-splash/modules$ reject-dict
^https://www\.gaoding\.com/api/v\d/oc/delivery-pits/(template|mine|home)-page-dialog/modules$ reject-dict
^https://www\.gaoding\.com/api/v\d/cp/search-words/v2/placeholder reject-dict

[Script]
GaoDing_remove_ads-op0 = type=http-response, pattern=^https://www\.gaoding\.com/api/v\d/oc/exhibitions/template/resources$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/GaoDing_remove_ads.js, requires-body=1, argument=0
GaoDing_remove_ads-op1 = type=http-response, pattern=^https://www\.gaoding\.com/api/v\d/oc/exhibitions/app_mine/resources$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/GaoDing_remove_ads.js, requires-body=1, argument=1
GaoDing_remove_ads-op2 = type=http-response, pattern=^https://www\.gaoding\.com/api/v\d/oc/exhibitions/(templates|all_editor_tools)/resources$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/GaoDing_remove_ads.js, requires-body=1, argument=2

[MITM]
hostname = %APPEND% www.gaoding.com
