#!name=快递100去广告（Egern转换版）
#!desc=移除横幅广告、弹窗广告，精简首页。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https?://p\.kuaidi100\.com/advertisement/ reject-dict
^https?://p\.kuaidi100\.com/e-commerce/act/actInfo\? reject-dict
^https?://p\.kuaidi100\.com/apicenter/card\.dox reject-dict

[Script]
KuaiDi100_remove_ads-op0 = type=http-response, pattern=^https?://p\.kuaidi100\.com/mobile/mobileapi\.do$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/KuaiDi100_remove_ads.js, requires-body=1, argument=0
KuaiDi100_remove_ads-op1 = type=http-response, pattern=^https?://p\.kuaidi100\.com/apicenter/xcx\.dox, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/KuaiDi100_remove_ads.js, requires-body=1, argument=1

[MITM]
hostname = %APPEND% p.kuaidi100.com
