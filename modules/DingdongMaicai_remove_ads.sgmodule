#!name=叮咚买菜去广告（Egern转换版）
#!desc=移除开屏广告、弹窗推广、搜索推荐、信息流广告、悬浮广告、各页面购物推荐、精简我的页面，移除底栏和各页面AI入口。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
DOMAIN, trackercollect.ddxq.mobi, REJECT
DOMAIN, ddfs-public.ddimg.mobi, REJECT
DOMAIN, rttrack.ddxq.mobi, REJECT

[URL Rewrite]
^https?://119\.29\.29\.\d+/d reject-200
^https?://maicai\.api\.ddxq\.mobi/advert/ reject
^https?://maicai\.api\.ddxq\.mobi/homeApi/getHomeAdPop reject
^https://maicai\.api\.ddxq\.mobi/vip/getVipAd/\? reject-dict
^https://maicai\.api\.ddxq\.mobi/homeApi/marketingNotice\? reject-dict
^https://maicai\.api\.ddxq\.mobi/search/rollHotKeyword\? reject-dict
^https://maicai\.api\.ddxq\.mobi/search/rankingList\? reject-dict
^https://maicai\.api\.ddxq\.mobi/search/hotKeyword\? reject-dict
^https://maicai\.api\.ddxq\.mobi/order/getRecommend$ reject-dict
^https://maicai\.api\.ddxq\.mobi/homeApi/userLike\? reject-dict
^https://user\.api\.ddxq\.mobi/userportal-service/api/v1/user/queryMyPage/\? reject-dict
^https://maicai\.api\.ddxq\.mobi/guide-service/userLike/flowData$ reject-dict

[Script]
DingdongMaicai_remove_ads-op0 = type=http-response, pattern=^https://maicai\.api\.ddxq\.mobi/homeApi/categoriesNewDetail\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/DingdongMaicai_remove_ads.js, requires-body=1, argument=0
DingdongMaicai_remove_ads-op1 = type=http-response, pattern=^https://maicai\.api\.ddxq\.mobi/tool/getConfig\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/DingdongMaicai_remove_ads.js, requires-body=1, argument=1
DingdongMaicai_remove_ads-op2 = type=http-response, pattern=^https?://maicai\.api\.ddxq\.mobi/homeApi/newDetails\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/DingdongMaicai_remove_ads.js, requires-body=1, argument=2
DingdongMaicai_remove_ads-op3 = type=http-response, pattern=^https?://maicai\.api\.ddxq\.mobi/homeApi/newDetails\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/DingdongMaicai_remove_ads.js, requires-body=1, argument=3
DingdongMaicai_remove_ads-op4 = type=http-response, pattern=^https://maicai\.api\.ddxq\.mobi/guide-service/productApi/productDetail/info\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/DingdongMaicai_remove_ads.js, requires-body=1, argument=4
DingdongMaicai_remove_ads-op5 = type=http-response, pattern=^https?://maicai\.api\.ddxq\.mobi/homeApi/bottomNavi, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/DingdongMaicai_remove_ads.js, requires-body=1, argument=5
DingdongMaicai_remove_ads-op6 = type=http-response, pattern=^https?://maicai\.api\.ddxq\.mobi/homeApi/homeFlowDetail, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/DingdongMaicai_remove_ads.js, requires-body=1, argument=6

[MITM]
hostname = %APPEND% 119.29.29.*, maicai.api.ddxq.mobi, user.api.ddxq.mobi
