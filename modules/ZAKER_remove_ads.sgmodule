#!name=ZAKER去广告（Egern转换版）
#!desc=移除开屏广告、置顶轮播图广告和文末广告。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://iphone\.myzaker\.com/zaker/cover\.php\? reject-dict
^https://iphone\.myzaker\.com/zaker/block_top_ad\.php\? reject-dict

[Script]
ZAKER_remove_ads-op0 = type=http-response, pattern=^https://iphone\.myzaker\.com/zaker/article_mongo_sec\.php\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/ZAKER_remove_ads.js, requires-body=1, argument=0
ZAKER_remove_ads-op1 = type=http-response, pattern=^https://ggs\.myzaker\.com/zk_article_ad\.php\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/ZAKER_remove_ads.js, requires-body=1, argument=1
ZAKER_remove_ads-op2 = type=http-response, pattern=^https://iphone\.myzaker\.com/zaker/follow_promote\.php\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/ZAKER_remove_ads.js, requires-body=1, argument=2
ZAKER_remove_ads-op3 = type=http-response, pattern=^https://iphone\.myzaker\.com/zaker/car_tab/index\.php\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/ZAKER_remove_ads.js, requires-body=1, argument=3

[MITM]
hostname = %APPEND% iphone.myzaker.com, ggs.myzaker.com
