#!name=Fileball网盘挂载（Egern转换版）
#!desc=支持挂载阿里云盘、夸克网盘和PikPak网盘，点击下方署名查看使用方法。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Script]
三合一网盘挂载 = type=http-request, pattern=^http://(aliyun|quark|pikpak)\.example\.com, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/Fileball/Fileball_mount.js, requires-body=1

[MITM]
hostname = %APPEND% aliyun.example.com, quark.example.com, pikpak.example.com
