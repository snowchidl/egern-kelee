捕获令牌 = type=http-request, pattern=^https?://apapia-sqk-weblogic\.manmanbuy\.com/baoliao/center/menu$, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/JD/JD_Price.js, requires-body=1
京东比价 = type=http-response, pattern=^https?://in\.m\.jd\.com/product/graphext/\d+\.html, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/JD/JD_Price.js, requires-body=1

