#!name=贝壳找房去广告（Egern转换版）
#!desc=移除开屏广告、弹窗广告、悬浮广告、信息流推广、我家页面的装修推荐。移除我的页面的专属推荐、游戏入口、钱包入口。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://apps\.api\.ke\.com/config/config/bootpage\? reject-dict
^https://apps\.api\.ke\.com/platform/shellapp/userCenter/feed\? reject-dict
^https://apps\.api\.ke\.com/config/config/getactivityconfig\? reject-dict

[Script]
Beike_remove_ads-op0 = type=http-response, pattern=^https://apps\.api\.ke\.com/platform/shellapp/homepage/initData/mini\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Beike_remove_ads.js, requires-body=1, argument=0
Beike_remove_ads-op1 = type=http-response, pattern=^https://apps\.api\.ke\.com/platform/shellapp/userCenter/info\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Beike_remove_ads.js, requires-body=1, argument=1
Beike_remove_ads-op2 = type=http-response, pattern=^https://apps\.api\.ke\.com/platform/shellapp/userCenter/info\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Beike_remove_ads.js, requires-body=1, argument=2
Beike_remove_ads-op3 = type=http-response, pattern=^https://apps\.api\.ke\.com/platform/shellapp/myhome/pagedetail\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Beike_remove_ads.js, requires-body=1, argument=3
Beike_remove_ads-op4 = type=http-response, pattern=^https://apps\.api\.ke\.com/platform/shellapp/homepage/feed\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Beike_remove_ads.js, requires-body=1, argument=4

[MITM]
hostname = %APPEND% apps.api.ke.com
