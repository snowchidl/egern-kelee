#!name=Spotify歌词增强（Egern转换版）
#!desc=将Spotify的外语歌词翻译为简体中文，并提供双语翻译支持。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Script]
跟踪响应·JSON = type=http-response, pattern=^https?://api\.spotify\.com/v1/tracks\?, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/Spotify/Spotify_response.js, requires-body=1
歌词请求·JSON = type=http-request, pattern=^https?://spclient\.wg\.spotify\.com/color-lyrics/v2/track/(.+)\?(.*)format=json, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/Spotify/Spotify_request.js, requires-body=1
歌词请求·Proto = type=http-request, pattern=^https?://spclient\.wg\.spotify\.com/color-lyrics/v2/track/\w+\?(.*), script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/Spotify/Spotify_request.js, requires-body=1, binary-body-mode=1
翻译歌词响应·JSON = type=http-response, pattern=^https?://spclient\.wg\.spotify\.com/color-lyrics/v2/track/(.+)\?(.*)format=json(.*)subtype=Translate, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/Spotify/Translate_response.js, requires-body=1
翻译歌词响应·Proto = type=http-response, pattern=^https?://spclient\.wg\.spotify\.com/color-lyrics/v2/track/\w+\?(.*)subtype=Translate, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/Spotify/Translate_response.js, requires-body=1, binary-body-mode=1
外部歌词响应·JSON = type=http-response, pattern=^https?://spclient\.wg\.spotify\.com/color-lyrics/v2/track/(.+)\?(.*)format=json(.*)subtype=External, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/Spotify/External_Lyrics_response.js, requires-body=1
外部歌词响应·Proto = type=http-response, pattern=^https?://spclient\.wg\.spotify\.com/color-lyrics/v2/track/\w+\?(.*)subtype=External, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/Spotify/External_Lyrics_response.js, requires-body=1, binary-body-mode=1

