#!name=BoxJs（Egern转换版）
#!desc=JavaScript数据管理器，用于管理脚本储存的数据。使用前请在本插件的详情页面为[PROXY]项分配代理策略。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
DOMAIN-SUFFIX, jsdelivr.net, PROXY

[Script]
BoxJS = type=http-request, pattern=^https?://(.+\.)?boxjs\.(com|net), script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/raw.githubusercontent.com/chavyleung/scripts/master/box/chavy.boxjs.js, requires-body=1

[MITM]
hostname = %APPEND% boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net
