#!name=薄荷健康去广告（Egern转换版）
#!desc=移除记录页大家都在看、移除各类弹窗，移除广场横幅推广，精简代谢中心页面。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://api\.boohee\.com/meta-interface/v1/index/page_float_bubbles\? reject-dict
^https://api\.boohee\.com/meta-interface/v1/index/tool_buttons\? reject-dict
^https://api\.boohee\.com/app-interface/v1/search/search\? reject-dict
^https://status\.boohee\.com/api/v1/merged_messages$ reject-dict
^https://bohe\.sfo-tx-shanghai-01\.saas\.sensorsdata\.cn/api/v2/sfo/user_popup_configs\? reject-dict
^https://api\.boohee\.com/meta-interface/v1/index/sensor-banners\? reject-dict

[Script]
BooHee_remove_ads-op0 = type=http-response, pattern=^https://api\.boohee\.com/meta-interface/v2/index\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/BooHee_remove_ads.js, requires-body=1, argument=0
BooHee_remove_ads-op1 = type=http-response, pattern=^https://api\.boohee\.com/meta-interface/v1/index/plaza\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/BooHee_remove_ads.js, requires-body=1, argument=1
BooHee_remove_ads-op2 = type=http-response, pattern=^https://api\.boohee\.com/open-interface/v1/string/market_page\?title=metabolism_config$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/BooHee_remove_ads.js, requires-body=1, argument=2
移除广场推荐页面横幅 = type=http-response, pattern=^https://api\.boohee\.com/meta-interface/v1/index/plaza-flow\?, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/BooHee/BooHee_remove_ads.js, requires-body=1

[MITM]
hostname = %APPEND% api.boohee.com, bohe.sfo-tx-shanghai-01.saas.sensorsdata.cn, lego.boohee.com, status.boohee.com
