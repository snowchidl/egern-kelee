#!name=TestFlight地区解锁（Egern转换版）
#!desc=解除TestFlight的区域限制，支持tvOS。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
DOMAIN, testflight.apple.com, PROXY

[Script]
TestFlightRegionUnlock-op0 = type=http-request, pattern=^https?://testflight\.apple\.com/v\d/accounts/.+?/install$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/TestFlightRegionUnlock.js, requires-body=1, argument=0

[MITM]
hostname = %APPEND% testflight.apple.com
