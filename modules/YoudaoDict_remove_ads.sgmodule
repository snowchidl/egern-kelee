#!name=网易有道词典去广告（Egern转换版）
#!desc=移除开屏广告、弹窗广告、右上角推广。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
ad-sdk-config.youdao.com

[URL Rewrite]
^https://dict\.youdao\.com/vip/activity/startup/ reject-dict
^https://dict\.youdao\.com/vip/activity/retention/configs\? reject-dict
^https://dict\.youdao\.com/vip/activity/retention/match\? reject-dict
^https://dict\.youdao\.com/vip/user/paid/guide\? reject-dict

[Script]
YoudaoDict_remove_ads-op0 = type=http-response, pattern=^https://dict\.youdao\.com/homepage/toolbar/get/, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/YoudaoDict_remove_ads.js, requires-body=1, argument=0

[MITM]
hostname = %APPEND% dict.youdao.com
