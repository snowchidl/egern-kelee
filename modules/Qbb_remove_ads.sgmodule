#!name=亲宝宝去广告（Egern转换版）
#!desc=移除开屏广告、弹窗广告、广告下发、用户行为上报，精简搜索页、育儿页和我的页面，拦截商城页面。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
DOMAIN, apimall.qbb6.com, REJECT

[URL Rewrite]
^https://api\.qbb6\.com/ad/ reject-dict
^https://api\.qbb6\.com/commons/main/tab/info/get\? reject-dict
^https://apicommunity\.qbb6\.com/community/recommend/user/get\? reject-dict
^https://apipt\.qbb6\.com/parenting/pt/home/post/card/get\? reject-dict
^https://apipt\.qbb6\.com/lib/search/hot/keys/v\d\? reject-dict
^https://apiuser\.qbb6\.com/user/member/info/get\? reject-dict
^https://apimall\.qbb6\.com/mall/v\d/goods/count\? reject-dict
^https://apimall\.qbb6\.com/mall/homepage/data/get/v\d$ reject-dict

[Script]
精简我的页面 = type=http-response, pattern=^https://api\.qbb6\.com/commons/self/button/group/get/v\d\?, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/Qbb/my.js, requires-body=1
精简育儿页面 = type=http-response, pattern=^https://apipt\.qbb6\.com/parenting/pt/homepage/get/v\d\?, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/Qbb/homepage.js, requires-body=1

[MITM]
hostname = %APPEND% api.qbb6.com, apicommunity.qbb6.com, apipt.qbb6.com, apiuser.qbb6.com, apimall.qbb6.com
