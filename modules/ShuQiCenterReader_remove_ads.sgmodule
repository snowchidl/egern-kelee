#!name=书旗小说去广告（Egern转换版）
#!desc=移除书城横幅广告、听书广告、阅读广告、章末推荐、福利入口、悬浮窗、推荐搜索词，精简我的页面。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
DOMAIN, render-web.11222.cn, REJECT

[URL Rewrite]
^https://huichuan\.sm\.cn/nativead reject-dict
^https://ocean\.shuqireader\.com/api/route/iosReadPage/adV2 reject-dict
^https://ocean\.shuqireader\.com/api/route/ios/readPage$ reject-dict
^https://ocean\.shuqireader\.com/api/render/load/resource reject

[Script]
移除书城横幅和阅读广告 = type=http-response, pattern=^https://ocean\.shuqireader\.com/sqios/render/render/page/bookstore$, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/ShuQiCenterReader/ShuQiCenterReader_remove_ads.js, requires-body=1

[MITM]
hostname = %APPEND% ocean.shuqireader.com, huichuan.sm.cn
