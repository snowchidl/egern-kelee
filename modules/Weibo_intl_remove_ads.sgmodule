#!name=微博轻享版去广告（Egern转换版）
#!desc=移除开屏广告、时间线广告及评论区广告，移除发现页面横幅推广、最常访问、主页访客及热门视频，移除搜索填充词。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://bootpreload\.uve\.weibo\.com/v1/ad/preload$ reject-dict
^https://api\.weibo\.cn/2/cardlist\?v_f=2 reject-dict
^https://api\.weibo\.cn/2/ad/ reject-dict
^https://weibointl\.api\.weibo\.cn/portal\.php\?a=get_searching_info reject-dict

[Script]
Weibo_intl_remove_ads-op0 = type=http-response, pattern=^https://weibointl\.api\.weibo\.cn/portal\.php\?a=trends, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Weibo_intl_remove_ads.js, requires-body=1, argument=0
Weibo_intl_remove_ads-op1 = type=http-response, pattern=^https://weibointl\.api\.weibo\.cn/portal\.php\?a=trends, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Weibo_intl_remove_ads.js, requires-body=1, argument=1
Weibo_intl_remove_ads-op2 = type=http-response, pattern=^https://api\.weibo\.cn/2/statuses/friends/timeline$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Weibo_intl_remove_ads.js, requires-body=1, argument=2
Weibo_intl_remove_ads-op3 = type=http-response, pattern=^https://api\.weibo\.cn/2/statuses/friends/timeline$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Weibo_intl_remove_ads.js, requires-body=1, argument=3
Weibo_intl_remove_ads-op4 = type=http-response, pattern=^https://api\.weibo\.cn/2/statuses/unread_hot_timeline$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Weibo_intl_remove_ads.js, requires-body=1, argument=4
Weibo_intl_remove_ads-op5 = type=http-response, pattern=^https://api\.weibo\.cn/2/statuses/unread_hot_timeline$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Weibo_intl_remove_ads.js, requires-body=1, argument=5
Weibo_intl_remove_ads-op6 = type=http-response, pattern=^https://api\.weibo\.cn/2/comments/build_comments\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Weibo_intl_remove_ads.js, requires-body=1, argument=6
Weibo_intl_remove_ads-op7 = type=http-response, pattern=^https://api\.weibo\.cn/2/statuses/container_detail\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Weibo_intl_remove_ads.js, requires-body=1, argument=7
Weibo_intl_remove_ads-op8 = type=http-response, pattern=^https://api\.weibo\.cn/2/cardlist\?aid=, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Weibo_intl_remove_ads.js, requires-body=1, argument=8
Weibo_intl_remove_ads-op9 = type=http-response, pattern=^https://weibointl\.api\.weibo\.cn/portal\.php\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Weibo_intl_remove_ads.js, requires-body=1, argument=9

[MITM]
hostname = %APPEND% bootpreload.uve.weibo.com, weibointl.api.weibo.cn, api.weibo.cn
