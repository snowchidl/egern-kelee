#!name=墨迹天气去广告（Egern转换版）
#!desc=移除天气页面横幅、工具栏，移除时景关注页面推荐，精简我的页面。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://fcard\.api\.moji\.com/flycard/flyCard\? reject
^https://vdo\.api\.moji\.com/shortvideo/card/subscribe$ reject-dict
^https://vdo\.api\.moji\.com/shortvideo/video/index_flow\? reject-dict
^https://vdo\.api\.moji\.com/shortvideo/video_user/hotGuyRcm\? reject-dict
^https://vdo\.api\.moji\.com/shortvideo/zone/follow_src_zone\? reject-dict
^https://sns\.api\.moji\.com/user/dynamic_v9/json/someone_interest\? reject-dict

[Script]
MojiWeather_remove_ads-op0 = type=http-response, pattern=^https://mme\.api\.moji\.com/json/entrance/list$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/MojiWeather_remove_ads.js, requires-body=1, argument=0

[MITM]
hostname = %APPEND% fcard.api.moji.com, vdo.api.moji.com, sns.api.moji.com, mme.api.moji.com, psnlz.api.moji.com
