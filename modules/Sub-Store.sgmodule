#!name=Sub-Store（Egern转换版）
#!desc=高级订阅管理工具，定时任务默认为每天23点55分，可在插件设置中自定义。使用前请在本插件的详情页面为[PROXY]项分配代理策略。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
DOMAIN, sub-store.vercel.app, PROXY

[Script]
Sub-Store Core = type=http-request, pattern=^https?://sub\.store/((download)|api/(preview|sync|(utils/node-info))), script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-1.min.js, requires-body=1
Sub-Store Simple = type=http-request, pattern=^https?://sub\.store, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-0.min.js, requires-body=1

[MITM]
hostname = %APPEND% sub.store
