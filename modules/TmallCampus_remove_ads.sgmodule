#!desc=移除广告配置、开屏广告、弹窗广告、AI助手、促销模块，精简我的页面。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://acs\.m\.taobao\.com/gw/mtop\.tmall\.campus\.guide\.advertising\.config\.list/ reject-dict
^https://acs\.m\.taobao\.com/gw/mtop\.tmall\.campus\.ai\.agent\.assistant\.settings\.get/ reject-dict
^https://acs\.m\.taobao\.com/gw/mtop\.tmall\.campus\.guide\.delivering\.recall\.general\.data\.query/ reject-dict
^https://acs\.m\.taobao\.com/gw/mtop\.tmall\.campus\.guide\.app\.home\.pop\.get/ reject-dict

[Script]
TmallCampus_remove_ads-op0 = type=http-response, pattern=^https://acs\.m\.taobao\.com/gw/mtop\.tmall\.kangaroo\.core\.service\.route\.fixrespagerecommend/, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/TmallCampus_remove_ads.js, requires-body=1, argument=0
TmallCampus_remove_ads-op1 = type=http-response, pattern=^https://acs\.m\.taobao\.com/gw/mtop\.tmall\.campus\.guide\.app\.userprofile\.framework\.v\d/, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/TmallCampus_remove_ads.js, requires-body=1, argument=1

[MITM]
hostname = %APPEND% acs.m.taobao.com
