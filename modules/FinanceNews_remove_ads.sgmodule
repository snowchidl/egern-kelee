[Script]
FinanceNews_remove_ads-op0 = type=http-response, pattern=^https://api-one-wscn\.awtmt\.com/apiv1/kvconfig/items/tabbarconfig1$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/FinanceNews_remove_ads.js, requires-body=1, argument=0
