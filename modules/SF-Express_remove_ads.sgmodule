#!name=顺丰速运去广告（Egern转换版）
#!desc=移除开屏广告、首页下拉抽屉、首页推广、应用内悬浮窗、横幅广告，移除主题，精简我的页面。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://ccsp-egmas\.sf-express\.com/cx-app-base/base/app/ad/ reject-dict
^https://ucmp\.sf-express\.com/proxy/esgcempcore/memberGoods/pointMallService/goodsList$ reject-dict

[Script]
SF-Express_remove_ads-op0 = type=http-response, pattern=^https://ucmp(-static)?\.sf-express\.com/proxy/ccspBase/module-config/(login/)?query\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/SF-Express_remove_ads.js, argument=0
SF-Express_remove_ads-op1 = type=http-response, pattern=^https://ccsp-egmas\.sf-express\.com/cx-app-base/base/app/appHomeConfig/query$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/SF-Express_remove_ads.js, requires-body=1, argument=1

[MITM]
hostname = %APPEND% ccsp-egmas.sf-express.com, ucmp.sf-express.com, ucmp-static.sf-express.com
