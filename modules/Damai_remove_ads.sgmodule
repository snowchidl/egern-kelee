#!name=大麦去广告（Egern转换版）
#!desc=移除开屏广告、轮播图广告和弹窗广告，移除搜索填充词和专属推荐。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://acs\.m\.taobao\.com/gw/mtop\.damai\.wireless\.home\.welcome/ reject-dict
^https://acs\.m\.taobao\.com/gw/mtop\.damai\.mec\.popup\.get/ reject-dict

[Script]
Damai_remove_ads-op0 = type=http-response, pattern=^https://acs\.m\.taobao\.com/gw/mtop\.damai\.wireless\.user\.my\.content\.get/, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Damai_remove_ads.js, requires-body=1, argument=0
Damai_remove_ads-op1 = type=http-response, pattern=^https://acs\.m\.taobao\.com/gw/mtop\.damai\.wireless\.mypage\.feed/, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Damai_remove_ads.js, requires-body=1, argument=1
Damai_remove_ads-op2 = type=http-response, pattern=^https://acs\.m\.taobao\.com/gw/mtop\.damai\.mec\.aristotle\.get/, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Damai_remove_ads.js, requires-body=1, argument=2

[MITM]
hostname = %APPEND% acs.m.taobao.com
