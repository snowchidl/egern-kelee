#!name=马蜂窝去广告（Egern转换版）
#!desc=移除首页信息流广告、商城横幅推广、我的页面弹窗。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
DOMAIN, advert.mafengwo.cn, REJECT

[URL Rewrite]
^https://mapi\.mafengwo\.cn/user/growth/get_growth_tip/v1\? reject-dict

[Script]
MaFengWo_remove_ads-op0 = type=http-response, pattern=^https://mapi\.mafengwo\.cn/discovery/get_index/v7\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/MaFengWo_remove_ads.js, requires-body=1, argument=0
MaFengWo_remove_ads-op1 = type=http-response, pattern=^https://mapi\.mafengwo\.cn/sales/home/get_header/v3\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/MaFengWo_remove_ads.js, requires-body=1, argument=1

[MITM]
hostname = %APPEND% mapi.mafengwo.cn
