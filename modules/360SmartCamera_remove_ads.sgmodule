#!name=360摄像机去广告（Egern转换版）
#!desc=移除开屏广告、首页推广、底栏商城入口及我的页面推广。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
DOMAIN, ad.jia.360.cn, REJECT
DOMAIN, ad.iot.360.cn, REJECT

[Script]
360SmartCamera_remove_ads-op0 = type=http-response, pattern=^https://jia\.360\.cn/conf/v1\.json, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/360SmartCamera_remove_ads.js, requires-body=1, argument=0

[MITM]
hostname = %APPEND% jia.360.cn
