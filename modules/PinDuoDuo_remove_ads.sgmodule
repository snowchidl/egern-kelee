[Script]
PinDuoDuo_remove_ads-op0 = type=http-response, pattern=^https://api\.pinduoduo\.com/api/alexa/homepage/hub\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/PinDuoDuo_remove_ads.js, requires-body=1, argument=0
PinDuoDuo_remove_ads-op1 = type=http-response, pattern=^https://api\.pinduoduo\.com/api/alexa/homepage/hub\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/PinDuoDuo_remove_ads.js, requires-body=1, argument=1
PinDuoDuo_remove_ads-op2 = type=http-response, pattern=^https://api\.pinduoduo\.com/search\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/PinDuoDuo_remove_ads.js, requires-body=1, argument=2
PinDuoDuo_remove_ads-op3 = type=http-response, pattern=^https://api\.pinduoduo\.com/api/philo/personal/hub\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/PinDuoDuo_remove_ads.js, requires-body=1, argument=3
PinDuoDuo_remove_ads-op4 = type=http-response, pattern=^https://api\.pinduoduo\.com/api/oak/integration/render\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/PinDuoDuo_remove_ads.js, requires-body=1, argument=4
PinDuoDuo_remove_ads-op5 = type=http-response, pattern=^https://api\.pinduoduo\.com/api/caterham/v3/query/order_detail_group\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/PinDuoDuo_remove_ads.js, requires-body=1, argument=5
PinDuoDuo_remove_ads-op6 = type=http-response, pattern=^https://api\.pinduoduo\.com/order/, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/PinDuoDuo_remove_ads.js, requires-body=1, argument=6
PinDuoDuo_remove_ads-op7 = type=http-response, pattern=^https://api\.pinduoduo\.com/api/aristotle/order_list_v4\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/PinDuoDuo_remove_ads.js, requires-body=1, argument=7
移除扫码取件页面商品推荐及弹窗 = type=http-response, pattern=^https://m\.pinduoduo\.net/mdkd/package\?from_app_scan, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/PinDuoDuo/PinDuoDuo_remove_ads.js, requires-body=1

[MITM]
hostname = %APPEND% api.pinduoduo.com, m.pinduoduo.net
