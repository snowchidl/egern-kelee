#!name=财新去广告（Egern转换版）
#!desc=过滤财新广告｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://entities\.caixin\.com/api/(dataplus/promotionHints|public/push/appIndex|public/recommendNews) reject-dict
^https://gateway\.caixin\.com/api/app-api/cxAdInfo/selectIndexAdInfo reject-dict
^https://mappsv5\.caixin\.com/channelv5/article_ad_ios_info\.json reject-dict
^https://gg\.caixin\.com/s\?z=caixin&slot=\d+ reject-dict
^https://msgapi\.caixin\.com/msg_api/annmsg/annlist reject-dict

[Script]
移除财新数据通广告 = type=http-response, pattern=^https://entities\.caixin\.com/api/dataplus/columns, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js, requires-body=1
移除文末广告 = type=http-response, pattern=^https://gateway\.caixin\.com/api/app-api/(caixinapp/appinfo|search/getkeyword), script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js, requires-body=1
移除财新FM广告 = type=http-response, pattern=^https://gateway\.caixin\.com/api/app-content/fm/index/list\?, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js, requires-body=1
移除开屏广告 = type=http-response, pattern=^https://gg\.caixin\.com/s\?z=caixin&op=\d, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js, requires-body=1
移除正文广告 = type=http-response, pattern=^https://mappsv5\.caixin\.com/articlev5/\d+/\d+\.json$, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js, requires-body=1
移除正文广告-2 = type=http-response, pattern=^https://mapps?v5\.caixin\.com/(channelv5/list|/?index_page_v5/)\w+, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js, requires-body=1

[MITM]
hostname = %APPEND% e*.caixin.com, g*.caixin.com, m*.caixin.com
