#!name=KOOK去广告（Egern转换版）
#!desc=移除开屏广告、房间横幅推广、促销活动、精简发现页面频道及我的页面，移除底栏商城入口。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://www\.kookapp\.cn/api/v3/ad/config$ reject-dict
^https://www\.kookapp\.cn/api/v3/promotion/ongoing$ reject-dict

[Script]
KOOK_remove_ads-op0 = type=http-response, pattern=^https://(m|www)\.kookapp\.cn/api/v\d/user/settings$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/KOOK_remove_ads.js, requires-body=1, argument=0
KOOK_remove_ads-op1 = type=http-response, pattern=^https://(m|www)\.kookapp\.cn/api/v\d/user/settings$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/KOOK_remove_ads.js, requires-body=1, argument=1
KOOK_remove_ads-op2 = type=http-response, pattern=^https://www\.kookapp\.cn/api/v3/discover/tab-list\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/KOOK_remove_ads.js, requires-body=1, argument=2

[MITM]
hostname = %APPEND% m.kookapp.cn, www.kookapp.cn
