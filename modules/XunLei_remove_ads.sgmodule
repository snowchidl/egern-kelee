#!name=迅雷去广告（Egern转换版）
#!desc=移除开屏广告、首页横幅广告、左上角广告入口，精简我的页面。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Script]
XunLei_remove_ads-op0 = type=http-response, pattern=^https://conf-m-ssl\.xunlei\.com/external/, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/XunLei_remove_ads.js, requires-body=1, argument=0
XunLei_remove_ads-op1 = type=http-response, pattern=^https://api-shoulei-ssl\.xunlei\.com/flowhub/v1/slots:batchGet$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/XunLei_remove_ads.js, requires-body=1, argument=1

[MITM]
hostname = %APPEND% conf-m-ssl.xunlei.com, api-shoulei-ssl.xunlei.com
