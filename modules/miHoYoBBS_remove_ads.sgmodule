#!name=米游社去广告（Egern转换版）
#!desc=移除开屏广告、搜索栏热搜及资讯、青少年模式弹窗。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://bbs-api(-ab)?\.miyoushe\.com/apihub/api/getAppSplash$ reject-dict
^https://bbs-api(-ab)?\.miyoushe\.com/apihub/api/getHotKeywordAndEvent$ reject-dict
^https://bbs-api-static\.miyoushe\.com/search/api/search/pre_keyword\? reject-dict

[Script]
miHoYoBBS_remove_ads-op0 = type=http-response, pattern=^https://bbs-api(-ab)?\.miyoushe\.com/apihub/api/getAppStartupData$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/miHoYoBBS_remove_ads.js, requires-body=1, argument=0
miHoYoBBS_remove_ads-op1 = type=http-response, pattern=^https://bbs-api(-ab)?\.miyoushe\.com/apihub/api/getAppConfig$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/miHoYoBBS_remove_ads.js, requires-body=1, argument=1
miHoYoBBS_remove_ads-op2 = type=http-response, pattern=^https://bbs-api-ab\.miyoushe\.com/teenager/api/info$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/miHoYoBBS_remove_ads.js, requires-body=1, argument=2

[MITM]
hostname = %APPEND% bbs-api.miyoushe.com, bbs-api-ab.miyoushe.com
