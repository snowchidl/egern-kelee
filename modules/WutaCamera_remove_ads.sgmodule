#!name=无他相机去广告（Egern转换版）
#!desc=移除开屏广告、拍摄页面广告、右小角广告，精简底栏。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Script]
WutaCamera_remove_ads-op0 = type=http-response, pattern=^https://api-release\.wuta-cam\.com/ad_tree$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/WutaCamera_remove_ads.js, requires-body=1, argument=0
WutaCamera_remove_ads-op1 = type=http-response, pattern=^https://api-release\.wuta-cam\.com/ad_tree$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/WutaCamera_remove_ads.js, requires-body=1, argument=1

[MITM]
hostname = %APPEND% api-release.wuta-cam.com
