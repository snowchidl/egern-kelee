#!name=京东去广告（Egern转换版）
#!desc=移除京东开屏广告，精简我的页面产品推广。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
URL-REGEX, "^http:\/\/\w{32}\.jddebug\.com\/diagnose\?", REJECT

[URL Rewrite]
^https://api\.m\.jd\.com/client\.action\?functionId=(searchBoxWord|stationPullService|uniformRecommend[06]) reject-dict

[Script]
JD_remove_ads-op0 = type=http-response, pattern=^https://api\.m\.jd\.com/client\.action\?functionId=basicConfig, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/JD_remove_ads.js, requires-body=1, argument=0
移除京东广告 = type=http-response, pattern=^https://api\.m\.jd\.com/client\.action\?functionId=(deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome), script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/JD/JD_remove_ads.js, requires-body=1

[MITM]
hostname = %APPEND% api.m.jd.com
