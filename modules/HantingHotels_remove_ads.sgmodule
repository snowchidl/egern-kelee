#!name=华住会去广告（Egern转换版）
#!desc=移除弹窗、横幅，精简首页。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://hweb-manager\.huazhu\.com/notice/getAppPopupNotifyAlert$ reject-dict
^https://hweb-hotel\.huazhu\.com/home/getHomeLoinBanner$ reject-dict
^https://hweb-hotel\.huazhu\.com//home/querySelectHotel$ reject-dict
^https://hweb-hotel\.huazhu\.com/home/queryHotelBrand$ reject-dict
^https://hweb-manager\.huazhu\.com/hotels/ad/getHotelListNoticeMerge$ reject-dict

[Script]
HantingHotels_remove_ads-op0 = type=http-response, pattern=^https://res-pub\.huazhu\.com/frontconf/homeconfig_45/\w+\.json$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/HantingHotels_remove_ads.js, requires-body=1, argument=0
HantingHotels_remove_ads-op1 = type=http-response, pattern=^https://res-pub\.huazhu\.com/frontconf/tabbarconfig_45/\w+\.json$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/HantingHotels_remove_ads.js, requires-body=1, argument=1

[MITM]
hostname = %APPEND% hweb-manager.huazhu.com, hweb-hotel.huazhu.com, res-pub.huazhu.com
