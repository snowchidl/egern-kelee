#!name=12306去广告（Egern转换版）
#!desc=过滤12306应用内广告及开屏广告｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
DOMAIN, ad.12306.cn, DIRECT

[Script]
12306_remove_ads-op0 = type=http-response, pattern=^https://ad\.12306\.cn/ad/ser/getAdList$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/12306_remove_ads.js, requires-body=1, argument=0
移除12306应用内广告 = type=http-request, pattern=^https://mobile\.12306\.cn/otsmobile/app/mgs/mgw\.htm$, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/12306/12306_remove_ads.js

[MITM]
hostname = %APPEND% ad.12306.cn, mobile.12306.cn
