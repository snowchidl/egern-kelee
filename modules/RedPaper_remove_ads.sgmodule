#!name=小红书去广告（Egern转换版）
#!desc=过滤信息流推广，移除图片及视频水印，如有异常，请先清除缓存再尝试。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
AND, ((PROTOCOL, QUIC), (DOMAIN-SUFFIX, xiaohongshu.com)), REJECT

[URL Rewrite]
^https://ci\.xiaohongshu\.com/system_config/watermark reject-img
^https://edith\.xiaohongshu\.com/api/sns/v1/surprisebox/(?:get_style|open|submit_action) reject-dict
^https://www\.xiaohongshu\.com/api/marketing/box/trigger\? reject-dict
^https://edith\.xiaohongshu\.com/api/sns/(?:v2/guide/user_banner|v3/note/guide) reject-dict
^https://www\.xiaohongshu\.com/api/sns/(?:v1/ads/resource|v2/hey/\w+/hey_gallery) reject-dict

[Script]
RedPaper_remove_ads-op0 = type=http-response, pattern=^https://edith\.xiaohongshu\.com/api/sns/v1/search/banner_list$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/RedPaper_remove_ads.js, requires-body=1, argument=0
RedPaper_remove_ads-op1 = type=http-response, pattern=^https://edith\.xiaohongshu\.com/api/sns/v1/search/hot_list$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/RedPaper_remove_ads.js, requires-body=1, argument=1
RedPaper_remove_ads-op2 = type=http-response, pattern=^https://edith\.xiaohongshu\.com/api/sns/v4/search/hint, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/RedPaper_remove_ads.js, requires-body=1, argument=2
RedPaper_remove_ads-op3 = type=http-response, pattern=^https://edith\.xiaohongshu\.com/api/sns/v4/search/trending\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/RedPaper_remove_ads.js, requires-body=1, argument=3
移除图片和实况照片水印 = type=http-response, pattern=^https://edith\.xiaohongshu\.com/api/sns/v1/note/(?:imagefeed|live_photo/save), script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=1
移除整体配置 ui = type=http-response, pattern=^https://edith\.xiaohongshu\.com/api/sns/v1/system/service/ui/config\?, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=1
移除开屏广告 config = type=http-response, pattern=^https://edith\.xiaohongshu\.com/api/sns/v1/system_service/config\?, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=1
移除开屏广告 splash_config = type=http-response, pattern=^https://edith\.xiaohongshu\.com/api/sns/v2/system_service/splash_config, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=1
移除详情页小部件、关注页感兴趣的人 = type=http-response, pattern=^https://edith\.xiaohongshu\.com/api/sns/v2/(?:note/widgets|user/followings/followfeed), script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=1
移除信息流广告 = type=http-response, pattern=^https://edith\.xiaohongshu\.com/api/sns/v4/followfeed\?, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=1
移除详情页感兴趣的人 = type=http-response, pattern=^https://edith\.xiaohongshu\.com/api/sns/v5/recommend/user/follow_recommend\?, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=1
移除评论区实况照片水印 = type=http-response, pattern=^https://edith\.xiaohongshu\.com/api/sns/(?:v1/interaction/comment/video/download|v5/note/comment/list), script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=1
移除图片和视频水印 = type=http-response, pattern=^https://edith\.xiaohongshu\.com/api/sns/(?:v2/note/feed|v3/note/videofeed), script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=1
移除信息流广告-2 = type=http-response, pattern=^https://(?:edith|rec)\.xiaohongshu\.com/api/sns/v6/homefeed\?, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=1
移除搜索页广告 = type=http-response, pattern=^https://(?:edith|so)\.xiaohongshu\.com/api/sns/v10/search/notes\?, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=1
移除视频水印 = type=http-response, pattern=^https://(?:edith|rec|www)\.xiaohongshu\.com/api/sns/(?:v4/note/videofeed|v10/note/video/save), script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=1

[MITM]
hostname = %APPEND% ci.xiaohongshu.com, edith.xiaohongshu.com, rec.xiaohongshu.com, so.xiaohongshu.com, www.xiaohongshu.com
