#!name=中国移动云盘去广告（Egern转换版）
#!desc=移除中国移动云盘开屏广告及应用内广告，首页的多余卡片可滑到最底部自定义隐藏掉，插件对此不做处理。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Script]
移除开屏广告 = type=http-response, pattern=^https://jzts\.cmpassport\.com/personalized/getPushContent, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/mobileClouds/mobileClouds_remove_ads.js, requires-body=1
移除应用内广告 = type=http-response, pattern=^https://ad\.mcloud\.139\.com/advertapi/adv-filter/, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/mobileClouds/mobileClouds_remove_ads.js, requires-body=1

[MITM]
hostname = %APPEND% jzts.cmpassport.com, ad.mcloud.139.com
