#!name=易校园去广告（Egern转换版）
#!desc=移除开屏广告、横幅广告、弹窗广告、悬浮广告、文末广告、消息广告、校园头条，精简首页金刚位和我的页面。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://compus\.xiaofubao\.com/compus/advertising/ reject-dict

[Script]
YiSchool_remove_ads-op0 = type=http-response, pattern=^https://compus\.xiaofubao\.com/compus/user/getUserExt$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/YiSchool_remove_ads.js, requires-body=1, argument=0
YiSchool_remove_ads-op1 = type=http-response, pattern=^https://compus\.xiaofubao\.com/compus/application/getHomeAppList$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/YiSchool_remove_ads.js, requires-body=1, argument=1

[MITM]
hostname = %APPEND% compus.xiaofubao.com
