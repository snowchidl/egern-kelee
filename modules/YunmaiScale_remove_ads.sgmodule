#!category=去广告

[URL Rewrite]
^https://yunmai\.sfo-tx-beijing-02\.saas\.sensorsdata\.cn/api/v2/sfo/user_popup_configs\? reject-dict
^https://restapi\.iyunmai\.com/ad-api/ reject-dict
^https://apisvr\.iyunmai\.com/api/ios/first-page-module/center_menu\.json\? reject-dict
^https://restapi\.iyunmai\.com/api/ios/ad/ reject-dict

[Script]
YunmaiScale_remove_ads-op0 = type=http-response, pattern=^https://apisvr\.iyunmai\.com/api/ios/apps/get-online-parameter-list\.json\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/YunmaiScale_remove_ads.js, requires-body=1, argument=0

[MITM]
hostname = %APPEND% yunmai.sfo-tx-beijing-02.saas.sensorsdata.cn, apisvr.iyunmai.com, restapi.iyunmai.com
