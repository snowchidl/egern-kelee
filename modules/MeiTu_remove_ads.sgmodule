#!name=美图秀秀去广告（Egern转换版）
#!desc=移除开屏广告、横幅推广，精简我的页面。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
DOMAIN, adui.tg.meitu.com, REJECT

[Script]
MeiTu_remove_ads-op0 = type=http-response, pattern=^https://api\.posters\.meitu\.com/common/init\.json, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/MeiTu_remove_ads.js, requires-body=1, argument=0

[MITM]
hostname = %APPEND% api.posters.meitu.com
