#!name=前程无忧去广告（Egern转换版）
#!desc=移除开屏广告、弹窗、信息流推广、职位页面推广和各类横幅推广。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://appapi\.51jobapp\.com/api/market/get_launch\.php\? reject-dict
^https://cupid\.51jobapp\.com/open/operation/get/latest/banner-list\? reject-dict
^https://cupid\.51jobapp\.com/open/51job-activities/secJob/queryHomeSecondConfigV2\? reject-dict
^https://cupid\.51jobapp\.com/open/noauth/jobs/detail/sesame-competitive/ reject-dict
^https://cupid\.51jobapp\.com/open/noauth/jobs/job-detail/user-rights\? reject-dict
^https://cupid\.51jobapp\.com/open/resume/strategy/resume-build\? reject-dict
^https://cupid\.51jobapp\.com/launch-hub/open/noauth/popUp/ reject-dict
^https://cupid\.51jobapp\.com/launch-hub/open/noauth/popUp/getHomePagePopUp\? reject-dict

[Script]
51Job_remove_ads-op0 = type=http-response, pattern=^https://cupid\.51jobapp\.com/open/noauth/recommend/job-tab-dynamic\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/51Job_remove_ads.js, requires-body=1, argument=0
51Job_remove_ads-op1 = type=http-response, pattern=^https://cupid\.51jobapp\.com/open/user-task/user/task/, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/51Job_remove_ads.js, requires-body=1, argument=1
51Job_remove_ads-op2 = type=http-response, pattern=^https://cupid\.51jobapp\.com/open/tab/good-job/modules\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/51Job_remove_ads.js, requires-body=1, argument=2

[MITM]
hostname = %APPEND% appapi.51jobapp.com, cupid.51jobapp.com
