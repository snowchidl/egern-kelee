#!name=百度网页去广告（Egern转换版）
#!desc=移除百度搜索移动端网页的首页广告信息流｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Script]
移除百度搜索首页信息流广告 = type=http-response, pattern=^https?://(www|m)\.baidu\.com/?($|\?from=\w{8,9}), script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/BaiduSearch/BaiduSearchHomePage_remove_ads.js, requires-body=1

[MITM]
hostname = %APPEND% m.baidu.com, www.baidu.com
