#!name=Uki去广告（Egern转换版）
#!desc=移除开屏广告、应用内悬浮窗，各类横幅、信息流广告、搜索填充词、我的页面广告。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://api\.chenlongtech\.cn/v\d/friends/startInfo$ reject-dict
^https://api\.chenlongtech\.cn/v\d/friends/indexBanner$ reject-dict
^https://api\.chenlongtech\.cn/v\d/friends/getPopup reject-dict
^https://api\.chenlongtech\.cn/v\d/friends/allPopUpConfig$ reject-dict
^https://api\.chenlongtech\.cn/v\d/friends/advConf$ reject-dict
^https://api\.chenlongtech\.cn/v\d/user/checkQTSheInsurance$ reject-dict

[Script]
移除匹配卡横幅 = type=http-response, pattern=^https://api\.chenlongtech\.cn/v\d/lover/productList, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/Uki/Uki_remove_ads.js, requires-body=1
移除密友横幅 = type=http-response, pattern=^https://api\.chenlongtech\.cn/v\d/friends/closeFriend/home, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/Uki/Uki_remove_ads.js, requires-body=1
移除娱乐页面横幅和悬浮窗配置 = type=http-response, pattern=^https://api\.chenlongtech\.cn/v\d/party/config$, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/Uki/Uki_remove_ads.js, requires-body=1
移除广场搜索填充词 = type=http-response, pattern=^https://api\.chenlongtech\.cn/v1/post/fetchSearchRecommend$, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/Uki/Uki_remove_ads.js, requires-body=1

[MITM]
hostname = %APPEND% api.chenlongtech.cn
