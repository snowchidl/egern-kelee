#!desc=移除横幅广告、弹窗广告，精简我的页面。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://api\.wakeup\.fun/wakeup/app/bannerconf$ reject-dict

[Script]
WakeupSchedule_remove_ads-op0 = type=http-response, pattern=^https://api\.wakeup\.fun/wakeup/user/mine$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/WakeupSchedule_remove_ads.js, requires-body=1, argument=0

[MITM]
hostname = %APPEND% api.wakeup.fun
