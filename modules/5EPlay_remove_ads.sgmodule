#!name=5EPlay去广告（Egern转换版）
#!desc=移除开屏广告、弹窗广告、活动角标、商城。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://ya-api-app\.5eplay\.com/v\d/search/kwd_top$ reject-dict

[Script]
5EPlay_remove_ads-op0 = type=http-response, pattern=^https://app\.5eplay\.com/api/app/dync_config\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/5EPlay_remove_ads.js, requires-body=1, argument=0
5EPlay_remove_ads-op1 = type=http-response, pattern=^https://app\.5eplay\.com/api/index/tab_v\d\?category_id=tab_1&page=\d$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/5EPlay_remove_ads.js, requires-body=1, argument=1
5EPlay_remove_ads-op2 = type=http-response, pattern=^https://ya-api-app\.5eplay\.com/v\d/search/config$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/5EPlay_remove_ads.js, requires-body=1, argument=2

[MITM]
hostname = %APPEND% app.5eplay.com, ya-api-app.5eplay.com
