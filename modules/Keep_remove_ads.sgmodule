#!name=Keep去广告（Egern转换版）
#!desc=移除开屏广告、搜索推荐和弹窗广告，精简底栏和首页标签。移除关注推荐、文章相关推荐和信息流中的课程推广。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
DOMAIN, kad.gotokeep.com, REJECT

[URL Rewrite]
^https://api\.gotokeep\.com/op-engine-webapp/v1/ad/ reject-dict
^https://api\.gotokeep\.com/search/v6/default/keyword/list\? reject-dict
^https://api\.gotokeep\.com/twins/v4/feed/followPage\? reject-dict
^https://api\.gotokeep\.com/twins/union/feed/function\? reject-dict
^https://api\.gotokeep\.com/guide-webapp/v1/popup/getPopUp\? reject-dict
^https://api\.gotokeep\.com/search/v5/hotCourse/list$ reject-dict
^https://api\.gotokeep\.com/search/v4/hotHashtag/list$ reject-dict
^https://api\.gotokeep\.com/search/v4/hotword/list\? reject-dict

[Script]
Keep_remove_ads-op0 = type=http-response, pattern=^https://api\.gotokeep\.com/op-engine-webapp/v1/configs$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Keep_remove_ads.js, requires-body=1, argument=0
Keep_remove_ads-op1 = type=http-response, pattern=^https://api\.gotokeep\.com/twins/union/feed/union_feed_all$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Keep_remove_ads.js, requires-body=1, argument=1
Keep_remove_ads-op2 = type=http-response, pattern=^https://api\.gotokeep\.com/twins/v4/feed/entryDetail\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Keep_remove_ads.js, requires-body=1, argument=2
Keep_remove_ads-op3 = type=http-response, pattern=^https://api\.gotokeep\.com/config/v3/basic\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Keep_remove_ads.js, requires-body=1, argument=3
Keep_remove_ads-op4 = type=http-response, pattern=^https://api\.gotokeep\.com/pencil-webapp/play/v1/games\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Keep_remove_ads.js, requires-body=1, argument=4

[MITM]
hostname = %APPEND% api.gotokeep.com
