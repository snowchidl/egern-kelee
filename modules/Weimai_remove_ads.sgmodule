#!name=微脉圈去广告（Egern转换版）
#!desc=移除开屏广告、聊天页横幅提示及发现页面的横幅广告。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Script]
Weimai_remove_ads-op0 = type=http-response, pattern=^https://confssl\d?\.iweimai\.cn/wm_ios_update\.json\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Weimai_remove_ads.js, requires-body=1, argument=0
Weimai_remove_ads-op1 = type=http-response, pattern=^https://confssl\d?\.iweimai\.cn/wm_ios_update\.json\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Weimai_remove_ads.js, requires-body=1, argument=1

[MITM]
hostname = %APPEND% confssl*.iweimai.cn
