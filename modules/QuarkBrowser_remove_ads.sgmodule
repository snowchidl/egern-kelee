#!name=夸克去广告（Egern转换版）
#!desc=移除阅读广告、各页面弹窗及横幅，精简我的页面。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://stars\.shuqireader\.com/kkios/render/load/resource/app$ reject-dict
^https://stars\.shuqireader\.com/kkios/render/load/resource/appConfig$ reject-dict

[Script]
QuarkBrowser_remove_ads-op0 = type=http-response, pattern=^https://open-cms-api\.quark\.cn/open-cms\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/QuarkBrowser_remove_ads.js, requires-body=1, argument=0

[MITM]
hostname = %APPEND% open-cms-api.quark.cn, stars.shuqireader.com
