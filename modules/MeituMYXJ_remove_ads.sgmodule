#!name=美颜相机去广告（Egern转换版）
#!desc=移除开屏广告、应用内弹窗，精简首页和我的页面。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
DOMAIN, adui.tg.meitu.com, REJECT

[URL Rewrite]
^https://api\.meiyan\.com/operation/home_banner\.json\? reject-dict
^https://api\.meiyan\.com/vip/permission_update_popup\.json\? reject-dict

[Script]
MeituMYXJ_remove_ads-op0 = type=http-response, pattern=^https://api\.meiyan\.com/operation/get_config\.json\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/MeituMYXJ_remove_ads.js, requires-body=1, argument=0
MeituMYXJ_remove_ads-op1 = type=http-response, pattern=^https://api\.meiyan\.com/operation/get_config\.json\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/MeituMYXJ_remove_ads.js, requires-body=1, argument=1
精简首页功能栏目并移除美颜推荐 = type=http-response, pattern=^https://api\.meiyan\.com/operation/home\.json\?, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/MeituMYXJ/MeituMYXJ_remove_ads.js, requires-body=1

[MITM]
hostname = %APPEND% api.meiyan.com
