#!name=得间小说去广告（Egern转换版）
#!desc=移除开屏广告、章末广告，移除扉页广告提示、听书界面广告提示、搜索栏填充词。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
DOMAIN, smad.ms.zhangyue.net, REJECT
DOMAIN, saad.ms.zhangyue.net, REJECT

[URL Rewrite]
^https://dj\.palmestore\.com/djad/ reject-dict
^https://dj\.palmestore\.com/zybk/api/ad/ reject-dict
^https://dj\.palmestore\.com/zyapi/bookstore/ad/ reject-dict
^https://dj\.palmestore\.com/zybk/api/bookshelf/index\? reject-dict

[Script]
iReaderDejian_remove_ads-op0 = type=http-response, pattern=^https://dj\.palmestore\.com/zybk/api/powerup/userGroup\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/iReaderDejian_remove_ads.js, requires-body=1, argument=0
iReaderDejian_remove_ads-op1 = type=http-response, pattern=^https://dj\.palmestore\.com/zybk/api/search/index\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/iReaderDejian_remove_ads.js, requires-body=1, argument=1

[MITM]
hostname = %APPEND% dj.palmestore.com
