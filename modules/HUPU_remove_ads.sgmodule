[URL Rewrite]
^https://games\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/bplapi/reddot/v1/app/getReddot reject-dict
^https://bbs\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/(bbsallapi/tag/v1/heatTag|bbsrankapi/v1/rating/list) reject-dict
^https://games\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/search/v2/(hintkeylist|hotkeylist) reject-dict
^https://goblin\.hupu\.com/\d/\d\.\d\.\d+/interfaceAd/getOther/v\d reject-dict
^https://goblin\.hupu\.com/\d/\d\.\d\.\d+/interfaceAd/getOther/batch reject-dict
^https://fairy\.mobileapi\.hupu\.com/gallery/getmod2 reject-200
^https://games\.mobileapi\.hupu\.com/3/8\.0\.86/bplcommentapi/bpl/score_tab/groups reject-dict
^https://games\.mobileapi\.hupu\.com/3/8\.0\.86/bplapi/banner/getLocationBanners reject-dict

[Script]
移除虎扑广告 = type=http-response, pattern=^https://fairy\.mobileapi\.hupu\.com/mang/preview/banners, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/HUPU/HUPU_remove_ads.js, requires-body=1
移除虎扑广告-2 = type=http-response, pattern=^https://bbs\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/bbsallapi/lego/data, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/HUPU/HUPU_remove_ads.js, requires-body=1
移除虎扑广告-3 = type=http-response, pattern=^https://games\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/buffer/hotList, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/HUPU/HUPU_remove_ads.js, requires-body=1
移除虎扑广告-4 = type=http-response, pattern=^https://games\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/bplapi/user/v1/more, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/HUPU/HUPU_remove_ads.js, requires-body=1

