#!name=成分喵去广告（Egern转换版）
#!desc=移除首页推广活动、广告组件请求、移除被查商品购买链接、搜索发现。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://app\.chengfenmiao\.com/Listing/LiveHots\? reject-dict
^https://app\.chengfenmiao\.com/helper/VersionCheck\? reject-dict
^https://app\.chengfenmiao\.com/item/closet\? reject-dict
^https://app\.chengfenmiao\.com/Helper/HotWords\? reject-dict

[Script]
ChengFenMiao_remove_ads-op0 = type=http-response, pattern=^https://app\.chengfenmiao\.com/helper/setting\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/ChengFenMiao_remove_ads.js, requires-body=1, argument=0

[MITM]
hostname = %APPEND% app.chengfenmiao.com
