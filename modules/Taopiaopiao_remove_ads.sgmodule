#!name=淘票票去广告（Egern转换版）
#!desc=移除开屏广告、悬浮广告、轮播图广告和弹窗广告，移除搜索填充词和为你推荐。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://acs\.m\.taobao\.com/gw/mtop\.film\.life\.popup\.get/ reject-dict
^https://acs\.m\.taobao\.com/gw/mtop\.film\.mtopindependentadvertiseapi\.queryadvertise/ reject-dict
^https://acs\.m\.taobao\.com/gw/mtop\.film\.mtopitemadvertiseapi\.queryadvertise/ reject-dict

[Script]
Taopiaopiao_remove_ads-op0 = type=http-response, pattern=^https://acs\.m\.taobao\.com/gw/mtop\.film\.mtopintegrationapi\.homeconfig/, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Taopiaopiao_remove_ads.js, requires-body=1, argument=0
Taopiaopiao_remove_ads-op1 = type=http-response, pattern=^https://acs\.m\.taobao\.com/gw/mtop\.film\.mtopintegrationapi\.homeconfig/, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Taopiaopiao_remove_ads.js, requires-body=1, argument=1
Taopiaopiao_remove_ads-op2 = type=http-response, pattern=^https://acs\.m\.taobao\.com/gw/mtop\.film\.life\.aristotle\.get/, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Taopiaopiao_remove_ads.js, requires-body=1, argument=2

[MITM]
hostname = %APPEND% acs.m.taobao.com
