#!name=飞客去广告（Egern转换版）
#!desc=移除开屏广告、首页广告、板块广告、帖内广告和我的页面广告。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://www\.flyert\.com\.cn/api/mobile/index\.php\?module=advis reject
^https://www\.flyert\.com\.cn/api/mobile/index\.php\?module=vip_coupon reject-dict
^https://ptf\.flyertrip\.com/static/img/common/ic_plate_mine_button\.png reject-img
^https://www\.flyert\.com\.cn/api/mobile/index\.php\?module=getdata reject-dict

[Script]
移除板块广告 = type=http-response, pattern=^https://www\.flyert\.com\.cn/api/mobile/index\.php\?version=5, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/FlyerTea/FlyerTea_remove_ads.js, requires-body=1
移除签到弹窗广告 = type=http-response, pattern=^https://www\.flyert\.com\.cn/api/mobile/index\.php\?module=plugin&id=k_misign:sign, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/FlyerTea/FlyerTea_remove_ads.js, requires-body=1

[MITM]
hostname = %APPEND% www.flyert.com.cn, ptf.flyertrip.com
