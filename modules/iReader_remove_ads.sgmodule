#!name=掌阅去广告（Egern转换版）
#!desc=移除开屏广告、悬浮广告、弹窗广告、朗读音色广告及我的页面广告，移除各页面的横幅轮播图。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
DOMAIN, saad.ms.zhangyue.net, REJECT

[URL Rewrite]
^https://(webboot\.zhangyue\.com|ih2\.ireader\.com)/zyapi/bookstore/ad/ reject-dict
^https://(webboot\.zhangyue\.com|ih2\.ireader\.com)/bookstore/ad/ reject-dict
^https://(webboot\.zhangyue\.com|ih2\.ireader\.com)/zybk/api/pop/index\? reject-dict
^https://(webboot\.zhangyue\.com|ih2\.ireader\.com)/zyapi/bookstore/user/mytab\? reject-dict
^https://(webboot\.zhangyue\.com|ih2\.ireader\.com)/zyboot/activity/mytab\? reject-dict
https://(webboot\.zhangyue\.com|ih2\.ireader\.com)/zyam/app/app\.php\? reject-dict

[Script]
iReader_remove_ads-op0 = type=http-response, pattern=^https://(webboot\.zhangyue\.com|ih2\.ireader\.com)/zybook4/iphone/u/p/api\.php\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/iReader_remove_ads.js, requires-body=1, argument=0
iReader_remove_ads-op1 = type=http-response, pattern=^https://(webboot\.zhangyue\.com|ih2\.ireader\.com)/bookstore/read/visual/channel/list\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/iReader_remove_ads.js, requires-body=1, argument=1

[MITM]
hostname = %APPEND% webboot.zhangyue.com, ih2.ireader.com
