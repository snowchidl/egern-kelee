[Script]
91160_remove_ads-op0 = type=http-response, pattern=^https://soapi\.91160\.com/homepage-recommendation/recommendation/medical/complex\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/91160_remove_ads.js, requires-body=1, argument=0
