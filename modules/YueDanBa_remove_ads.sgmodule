#!name=省钱快报去广告（Egern转换版）
#!desc=移除开屏广告、横幅广告、商品推荐，精简我的页面。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://api\.17gwx\.com/v2/base/app/ad\? reject-dict
^https://api\.17gwx\.com/v2/growth/popup/remind$ reject-dict
^https://api\.17gwx\.com/v2/recommend/feed/list\? reject-dict
^https://api\.17gwx\.com/v2/homepage/feed/similarList\? reject-dict

[Script]
YueDanBa_remove_ads-op0 = type=http-response, pattern=^https://api\.17gwx\.com/operate/elements\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/YueDanBa_remove_ads.js, requires-body=1, argument=0

[MITM]
hostname = %APPEND% api.17gwx.com
