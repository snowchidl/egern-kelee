^https://api-evone\.echargenet\.com/gw/evone\.appsns\.open\.efriend\.post\.listapppost/ reject-dict
^https://api-evone\.echargenet\.com/gw/evone\.appsns\.open\.merchant\.merchant\.list/ reject-dict
^https://api-evone\.echargenet\.com/gw/evone\.appsns\.open\.merchant\.news\.pagelistapp/ reject-dict

[MITM]
hostname = %APPEND% aserver-evone.echargenet.com, api-evone.echargenet.com
