#!name=宝宝树孕育去广告（Egern转换版）
#!desc=过滤宝宝树孕育广告｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
URL-REGEX, "^http:\/\/go\.babytree\.com\/go_pregnancy\/api\/(index_activity\/get_app_index_activity|sign\/sign_h_5)\?", REJECT-DICT
URL-REGEX, "^http:\/\/go\.babytree\.com\/go_search\/api\/mobile_search_new\/get_multi_search_default_keywords\?", REJECT-DICT
URL-REGEX, "^http:\/\/m\.meitun\.com\/newapi\/router\/topic\/hometptf\/feedRecommend", REJECT-DICT
URL-REGEX, "^http:\/\/pic08\.babytreeimg\.com\/knowledge\/2022\/0923\/\w+", REJECT
URL-REGEX, "^http:\/\/plough\.babytree\.com\/plough\.do", REJECT-DICT

[Script]
调整整体配置 = type=http-response, pattern=^http://api\.babytree\.com/bafconfigcenter_intf/config/get\?, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/BabyTree/BabyTree_remove_ads.js, requires-body=1
移除各页面推广 = type=http-response, pattern=^http://go\.babytree\.com/go_pregnancy/api/(app_index/get_app_tab|cms_column/get_column_list|feeds/get_index_feeds_list|user/get_user_info)\?, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/BabyTree/BabyTree_remove_ads.js, requires-body=1
移除搜索列表推广 = type=http-response, pattern=^http://go\.babytree\.com/go_search/api/mobile_search_new/search_index, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/BabyTree/BabyTree_remove_ads.js, requires-body=1

[MITM]
hostname = %APPEND% api.babytree.com, go.babytree.com
