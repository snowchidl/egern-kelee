#!name=Apple天气增强（Egern转换版）
#!desc=解锁Apple天气的全部功能、替换空气质量数据源、添加下一小时降水数据、添加天气数据。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
DOMAIN, weather-analytics-events.apple.com, REJECT-DROP
DOMAIN, tether.edge.apple, REJECT-DROP
DOMAIN-SUFFIX, tthr.apple.com, REJECT-DROP
AND, ((OR, ((IP-ASN, 714, no-resolve), (IP-ASN, 6185, no-resolve))), (PROTOCOL, QUIC)), REJECT-DROP

[Script]
天气可用性响应 = type=http-response, pattern=^https?://weatherkit\.apple\.com/api/v1/availability/, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/github.com/NSRingo/WeatherKit/releases/download/v3.1.0/response.bundle.js, requires-body=1
天气响应 = type=http-response, pattern=^https?://weatherkit\.apple\.com/api/v2/weather/, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/github.com/NSRingo/WeatherKit/releases/download/v3.1.0/response.bundle.js, requires-body=1, binary-body-mode=1

[MITM]
hostname = %APPEND% weatherkit.apple.com
