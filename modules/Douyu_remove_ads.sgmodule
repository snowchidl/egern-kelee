#!name=斗鱼去广告（Egern转换版）
#!desc=移除开屏、首页视频流、首页轮播图广告，移除直播间悬浮窗。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
URL-REGEX, "^http:\/\/linkmicschedule\.douyucdn\.cn\/im_schedule\/im_gate_list", REJECT
AND, ((DEST-PORT, 18000), (PROTOCOL, STUN)), REJECT
DOMAIN, stun1.douyucdn.cn, REJECT
DOMAIN, stun1.qvb.qcloud.com, REJECT
^(http:\/\/)((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\/(hlsh5p1\.douyucdn2\.cn)(.*) 307 $1$5$6

[URL Rewrite]
^https://rtbapi\.douyucdn\.cn/japi/sign/app/getinfo reject-dict

[Script]
Douyu_remove_ads-op0 = type=http-response, pattern=^https://apiv2\.douyucdn\.cn/japi/entrance/roomRes/nc/m/list, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Douyu_remove_ads.js, requires-body=1, argument=0
Douyu_remove_ads-op1 = type=http-response, pattern=^https://venus\.douyucdn\.cn/venus/config/static/update.+keyCodeSet=flow_config, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/Douyu_remove_ads.js, requires-body=1, argument=1
移除首页轮播图和视频流广告 = type=http-response, pattern=^https://apiv2\.douyucdn\.cn/mgapi/livenc/home/getRecV3, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/Douyu/Douyu_remove_ads.js, requires-body=1

[MITM]
hostname = %APPEND% rtbapi.douyucdn.cn, apiv2.douyucdn.cn, venus.douyucdn.cn
