#!name=阿里云盘去广告（Egern转换版）
#!desc=移除首页广告横幅、弹窗和顶部奖励。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
IP-CIDR, 203.107.1.1/24, REJECT, no-resolve

[URL Rewrite]
^https://member\.alipan\.com/v2/activity/sign_in_luckyBottle reject-dict
^https://api\.alipan\.com/adrive/v1/file/getTopFolders reject-dict

[Script]
移除阿里云盘广告 = type=http-response, pattern=^https://(biz)?api\.alipan\.com/apps/v\d/users?/home/(news|widgets), script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/AliYunDrive/AliYunDrive_remove_ads.js, requires-body=1
移除阿里云盘广告-2 = type=http-response, pattern=^https://member\.alipan\.com/v1/users/onboard_list, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/AliYunDrive/AliYunDrive_remove_ads.js, requires-body=1

[MITM]
hostname = %APPEND% api.alipan.com, member.alipan.com, bizapi.alipan.com
