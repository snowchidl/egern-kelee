#!name=一刻相册去广告（Egern转换版）
#!desc=移除开屏广告、横幅广告和弹窗推广。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://pan\.baidu\.com/act/api/conf\?.*conf_key=youa_core_config_ios reject-dict
^https://pan\.baidu\.com/youai/material/v1/getbynavid\?.*nav_id=1 reject-dict

[Script]
BaiduPhoto_remove_ads-op0 = type=http-response, pattern=^https://mbd\.baidu\.com/ccs/v1/start/confsync\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/BaiduPhoto_remove_ads.js, requires-body=1, argument=0

[MITM]
hostname = %APPEND% pan.baidu.com, mbd.baidu.com
