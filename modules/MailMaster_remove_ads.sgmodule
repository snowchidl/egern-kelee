#!name=网易邮箱大师去广告（Egern转换版）
#!desc=移除网易邮箱大师开屏广告、签到任务提醒，精简侧拉抽屉和我的页面。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://appconf\.mail\.163\.com/mailmaster/api/http/urlConfig\.do$ reject-dict
^https://dashi\.163\.com/task-center-api/fapi/task/list$ reject-dict
^https://appconf\.mail\.163\.com/mailoperating/mailmaster/api/operator/get$ reject-dict

[Script]
MailMaster_remove_ads-op0 = type=http-response, pattern=^https://appconf\.mail\.163\.com/mailmaster/api/page/v2/conf\.do$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/MailMaster_remove_ads.js, requires-body=1, argument=0
MailMaster_remove_ads-op1 = type=http-response, pattern=^https://appconf\.mail\.163\.com/mailmaster/api/config/function\.do$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/MailMaster_remove_ads.js, requires-body=1, argument=1

[MITM]
hostname = %APPEND% appconf.mail.163.com, dashi.163.com
