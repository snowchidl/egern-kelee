#!name=多屏互动去广告（Egern转换版）
#!desc=移除开屏广告、横幅推广、搜索填充词，移除广告下发。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://tcast-o\.api\.leiniao\.com/tcast/ads/ reject-dict
^https://tcast-o\.api\.leiniao\.com/tcast/v\d/selection/banner$ reject-dict
^https://tcast-o\.api\.leiniao\.com/tcast/v\d/searchrank$ reject-dict
^https://tcast-o\.api\.leiniao\.com/tcast/v\d/selection\? reject-dict
^https://tcast-o\.api\.leiniao\.com/tcast/message/v\d/activity\? reject-dict

[Script]
TCLnScreen_remove_ads-op0 = type=http-response, pattern=^https://tcast-o\.api\.leiniao\.com/tcast/v\d/config/function\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/TCLnScreen_remove_ads.js, requires-body=1, argument=0

[MITM]
hostname = %APPEND% tcast-o.api.leiniao.com
