#!category=去广告

[URL Rewrite]
^https://appactivity\.wmpvp\.com/hotsearch/all\? reject-dict

[Script]
PerfectWorldEsport_remove_ads-op0 = type=http-response, pattern=^https://api\.wmpvp\.com/api/v1/config/promote$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/PerfectWorldEsport_remove_ads.js, requires-body=1, argument=0

[MITM]
hostname = %APPEND% api.wmpvp.com, appactivity.wmpvp.com
