#!name=VVebo时间线修复（Egern转换版）
#!desc=修复失效的用户时间线和我的页面。使用此插件前需要禁用微博去广告插件，避免插件冲突导致失效。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Script]
修复时间线 = type=http-request, pattern=^https://api\.weibo\.cn/2/users/show\?, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/VVebo/VVebo_repair.js
修复时间线-2 = type=http-request, pattern=^https://api\.weibo\.cn/2/statuses/user_timeline\?, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/VVebo/VVebo_repair.js
修复时间线-3 = type=http-request, pattern=^https://api\.weibo\.cn/2/remind/unread_count\?, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/VVebo/VVebo_repair.js
修复时间线-4 = type=http-response, pattern=^https://api\.weibo\.cn/2/profile/statuses/tab\?, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/VVebo/VVebo_repair.js, requires-body=1
修复我的页面 = type=http-response, pattern=^https://api\.weibo\.cn/2/cardlist\?, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/VVebo/VVebo_repair.js, requires-body=1

[MITM]
hostname = %APPEND% api.weibo.cn
