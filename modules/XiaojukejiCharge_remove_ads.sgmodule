#!name=小桔充电去广告（Egern转换版）
#!desc=移除横幅广告、弹窗广告，精简我的页面。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://energy\.xiaojukeji\.com/energy/hummer/api/resource/display($|\?) reject-dict
^https://energy\.xiaojukeji\.com/lego/api/orderSprint/stair/info($|\?) reject-dict
^https://energy\.xiaojukeji\.com/station-api/search/preWords$ reject-dict

[Script]
XiaojukejiCharge_remove_ads-op0 = type=http-response, pattern=^https://energy\.xiaojukeji\.com/am/marketing/api/member/facade/charge/personal/center\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/XiaojukejiCharge_remove_ads.js, requires-body=1, argument=0
XiaojukejiCharge_remove_ads-op1 = type=http-response, pattern=^https://am\.didistatic\.com/static/am/cf-terminal/epower/epower-thanos-app/\d+\.\d+\.\d+/pages/people/index\.js$, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/XiaojukejiCharge_remove_ads.js, argument=1

[MITM]
hostname = %APPEND% energy.xiaojukeji.com, am.didistatic.com
