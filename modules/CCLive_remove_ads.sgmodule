#!name=CC直播去广告（Egern转换版）
#!desc=移除信息流推广和横幅，精简顶部标签。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://cc\.163\.com/act/m/daily/ad_ reject
^http://mshare\.cc\.163\.com/mshare/startadv_mobile_v\d\? reject-dict
^https://appapi\.cc\.163\.com/v\d/mixfloatingwindow/floating_windows\? reject-dict
^http://api\.cc\.163\.com/v1/mpopuprecommend/exit_room_conf$ reject-dict

[Script]
CCLive_remove_ads-op0 = type=http-response, pattern=^https://api\.cc\.163\.com/v\d/mgamenavigation/navigation_list\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/CCLive_remove_ads.js, requires-body=1, argument=0
CCLive_remove_ads-op1 = type=http-response, pattern=^https://api\.cc\.163\.com/v\d/mgamerecpage/recommend_page\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/CCLive_remove_ads.js, requires-body=1, argument=1
CCLive_remove_ads-op2 = type=http-response, pattern=^https://api\.cc\.163\.com/v\d/entpage/live_navbar_mobile/ios\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/CCLive_remove_ads.js, requires-body=1, argument=2

[MITM]
hostname = %APPEND% api.cc.163.com, cc.163.com, mshare.cc.163.com, appapi.cc.163.com
