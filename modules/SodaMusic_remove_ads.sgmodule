[URL Rewrite]
^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/commerce/upsells_config\? reject-dict
^https://(api|api5-lq)\.qishui\.com/luna/ads/ reject-dict
^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/ads/ reject-dict
^https://webcast-open\.douyin\.com/webcast/openapi/feed/\? reject-dict
^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/treasure/entrance/config\? reject-dict
^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/activities\? reject-dict
^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/media_ads\? reject-dict
^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/commerce/upsells\? reject-dict
^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/commerce/v2/commerce_info\? reject-dict
^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/listen-video/reminder\? reject-dict

[Script]
SodaMusic_remove_ads-op0 = type=http-response, pattern=^https://tnc\d-(bjlgy|ali[a-z]{2})\d?\.zijieapi\.com/get_domains/v\d/\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/SodaMusic_remove_ads.js, requires-body=1, argument=0
SodaMusic_remove_ads-op1 = type=http-response, pattern=^https://tnc\d-(bjlgy|ali[a-z]{2})\d?\.zijieapi\.com/get_domains/v\d/\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/SodaMusic_remove_ads.js, requires-body=1, argument=1
SodaMusic_remove_ads-op2 = type=http-response, pattern=^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/me\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/SodaMusic_remove_ads.js, requires-body=1, argument=2
SodaMusic_remove_ads-op3 = type=http-response, pattern=^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/feed/song-tab\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/SodaMusic_remove_ads.js, requires-body=1, argument=3
SodaMusic_remove_ads-op4 = type=http-response, pattern=^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/card\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/SodaMusic_remove_ads.js, requires-body=1, argument=4
SodaMusic_remove_ads-op5 = type=http-response, pattern=^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/card\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/SodaMusic_remove_ads.js, requires-body=1, argument=5
SodaMusic_remove_ads-op6 = type=http-response, pattern=^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/more-panel\?, script-path=https://raw.githubusercontent.com/snowchidl/egern-kelee/main/js/SodaMusic_remove_ads.js, requires-body=1, argument=6
移除播放页面视频流 = type=http-response, pattern=^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/me/recently-played-media\?, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/SodaMusic/SodaMusic_remove_ads.js, requires-body=1

