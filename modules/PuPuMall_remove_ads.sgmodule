#!name=朴朴超市去广告（Egern转换版）
#!desc=移除超市去开屏广告，移除首页顶部轮播图和图标广告、启动小弹图广告、首页右下角悬浮动画、搜索热搜榜、搜索建议词、搜索发现热词、订单页面商，精简我的页面。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[URL Rewrite]
^https://j1\.pupuapi\.com/client/account/discount/order reject
^https://j1\.pupuapi\.com/client/marketing/banner/v7\?position_types=100 reject

[Script]
移除朴朴超市广告 = type=http-response, pattern=^https://j1\.pupuapi\.com/client/marketing/banner/v7, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js, requires-body=1
移除朴朴超市广告-2 = type=http-response, pattern=^https://j1\.pupuapi\.com/client/marketing/banner/search_component_banner, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js, requires-body=1
移除朴朴超市广告-3 = type=http-response, pattern=^https://j1\.pupuapi\.com/client/search/hot_keywords/v3, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js, requires-body=1
移除朴朴超市广告-4 = type=http-response, pattern=^https://j1\.pupuapi\.com/client/app_resource/resource_preload/list_h5_resource, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js, requires-body=1
移除朴朴超市广告-5 = type=http-response, pattern=^https://j1\.pupuapi\.com/client/recommendation/interests/products, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js, requires-body=1
移除朴朴超市广告-6 = type=http-response, pattern=^https://j1\.pupuapi\.com/client/marketing/advertisement/v1, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js, requires-body=1

