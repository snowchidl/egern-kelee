#!name=Script-Hub（Egern转换版）
#!desc=将其他工具的Rewrite、Rule和JavaScript资源转换为Loon能识别的格式，使用前请在本插件的详情页面为[PROXY]项分配代理策略。在插件列表中点击此插件上的链接查看使用方法。｜源：可莉 Loon 插件 2026-11-10 快照，已转换为 Surge/Egern 模块
#!category=去广告

[Rule]
DOMAIN, scripthub.vercel.app, PROXY

[Script]
前端界面 = type=http-request, pattern=^https?://script\.hub/($|edit/|reload), script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/script-hub.js
Rewrite转换 = type=http-request, pattern=^https?://script\.hub/file/_start_/.+type=(?:qx-rewrite|surge-module|loon-plugin|all-module), script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/Rewrite-Parser.js
Rule转换 = type=http-request, pattern=^https?://script\.hub/file/_start_/.+type=rule-set, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/rule-parser.js
JavaScript转换 = type=http-request, pattern=^https?://script\.hub/convert/, script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/script-converter.js

[MITM]
hostname = %APPEND% script.hub, *.script.hub
